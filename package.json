{
  "name": "playerforge",
  "version": "0.7.0",
  "description": "Firefox 154+ / Tampermonkey 5.5+ (MV2) exclusive HTML5 video player enhancer with gestures, hotkeys, progress resume, subtitles, and an extensible plugin system",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "build:min": "node esbuild.config.mjs --min",
    "dev": "node esbuild.config.mjs --watch",
    "dev:min": "node esbuild.config.mjs --watch --min",
    "test": "node --import ./tests/loader.mjs --test",
    "bench": "node bench/run.mjs",
    "bench:record": "node bench/run.mjs --record"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "jsdom": "^29.1.1"
  }
}
