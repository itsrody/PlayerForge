{
  "name": "playerforge",
  "version": "2.0.3",
  "description": "HTML5 video player enhancer, built natively for Firefox 157+ (desktop and Android) running under Violentmonkey MV2 2.49+.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "dev": "node esbuild.config.mjs --watch",
    "lint": "eslint src/ platform/",
    "test": "node --import ./tests/loader.mjs --test tests/*.test.mjs",
    "bench": "node bench/run.mjs",
    "bench:record": "node bench/run.mjs --record",
    "integration": "node platform/run.mjs integration",
    "vm-smoke": "node platform/vm-smoke.mjs",
    "browser-bench": "node platform/run.mjs browser-bench",
    "browser-bench:record": "node platform/run.mjs browser-bench --record",
    "ci": "node platform/run.mjs ci",
    "platform": "node platform/run.mjs all"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "esbuild": "^0.24.0",
    "eslint": "^10.9.1",
    "jsdom": "^29.1.1",
    "selenium-webdriver": "^4.48.0"
  }
}
